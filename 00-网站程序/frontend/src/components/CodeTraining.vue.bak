<script setup lang="ts">
import { ref, computed, onMounted } from 'vue'
import { useCS408Store } from '@/stores/cs408'
import { ElMessage } from 'element-plus'

const cs408Store = useCS408Store()

const activeTab = ref('problems')
const selectedProblem = ref<any>(null)
const userCode = ref('')
const testResults = ref<any>(null)
const isRunning = ref(false)

// 计算属�?
const filteredProblems = computed(() => {
  return cs408Store.codeProblems
})

const problemStats = computed(() => cs408Store.problemStats)

const renderMarkdown = (text: string) => {
  // 简单的markdown渲染（实际应用中应该使用专门的markdown库）
  return text
    .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
    .replace(/\*(.*?)\*/g, '<em>$1</em>')
    .replace(/`(.*?)`/g, '<code>$1</code>')
}

const selectProblem = (problem: any) => {
  selectedProblem.value = problem
  userCode.value = problem.template || ''
  testResults.value = null
}

const runCode = async () => {
  if (!selectedProblem.value || !userCode.value.trim()) {
    ElMessage.warning('请先选择题目并编写代�?)
    return
  }

  isRunning.value = true
  try {
    // 保存用户代码
    await cs408Store.updateProblemSolution(selectedProblem.value.id, userCode.value)
    
    // 运行测试
    testResults.value = cs408Store.runTestCase(selectedProblem.value.id, userCode.value)
    
    if (testResults.value.passed === testResults.value.total) {
      ElMessage.success('所有测试通过�?)
    } else {
      ElMessage.warning(`通过 ${testResults.value.passed}/${testResults.value.total} 个测试`)
    }
  } catch (error) {
    ElMessage.error('代码执行出错')
    console.error('代码执行错误:', error)
  } finally {
    isRunning.value = false
  }
}

const submitSolution = async () => {
  if (!selectedProblem.value || !userCode.value.trim()) {
    ElMessage.warning('请先编写解决方案')
    return
  }

  try {
    const completed = await cs408Store.completeProblem(selectedProblem.value.id, userCode.value)
    
    if (completed) {
      ElMessage.success('题目完成！获得积分奖�?)
    } else {
      ElMessage.info('继续努力，还有测试未通过')
    }
  } catch (error) {
    ElMessage.error('提交失败')
  }
}

const getDifficultyTag = (difficulty: string) => {
  const tags: Record<string, any> = {
    easy: { type: 'success', text: '简�? },
    medium: { type: 'warning', text: '中等' },
    hard: { type: 'danger', text: '困难' }
  }
  return tags[difficulty] || { type: 'info', text: difficulty }
}

onMounted(() => {
  cs408Store.initializeCS408Data()
})
</script>

<template>
  <div class="code-training-container">
    <!-- 顶部统计 -->
    <div class="stats-section">
      <h2 class="section-title">408代码实战训练</h2>
      <p class="section-description">通过编程练习提升算法和数据结构能�?/p>
      
      <div class="stats-cards">
        <div class="stat-card">
          <div class="stat-value">{{ problemStats.solved }}</div>
          <div class="stat-label">已解�?/div>
        </div>
        <div class="stat-card">
          <div class="stat-value">{{ problemStats.total }}</div>
          <div class="stat-label">总题�?/div>
        </div>
        <div class="stat-card">
          <div class="stat-value">{{ problemStats.hard }}</div>
          <div class="stat-label">困难�?/div>
        </div>
        <div class="stat-card">
          <div class="stat-value">{{ Math.round((problemStats.solved / Math.max(1, problemStats.total)) * 100) }}%</div>
          <div class="stat-label">解决�?/div>
        </div>
      </div>
    </div>

    <!-- 题目列表和编辑器 -->
    <div class="training-content">
      <el-tabs v-model="activeTab" class="training-tabs">
        <el-tab-pane label="题目列表" name="problems">
          <div class="problems-grid">
            <el-card 
              v-for="problem in filteredProblems" 
              :key="problem.id"
              class="problem-card"
              :class="{ 'selected': selectedProblem?.id === problem.id }"
              @click="selectProblem(problem)"
            >
              <div class="problem-header">
                <h3>{{ problem.title }}</h3>
                <el-tag :type="getDifficultyTag(problem.difficulty).type" size="small">
                  {{ getDifficultyTag(problem.difficulty).text }}
                </el-tag>
              </div>
              
              <div class="problem-description" v-html="renderMarkdown(problem.description)"></div>
              
              <div class="problem-tags">
                <el-tag 
                  v-for="tag in problem.tags" 
                  :key="tag"
                  size="small"
                  type="info"
                >
                  {{ tag }}
                </el-tag>
              </div>
              
              <div class="problem-status">
                <el-tag v-if="problem.completed" type="success" size="small">
                  已完�?
                </el-tag>
                <el-tag v-else type="warning" size="small">
                  未完�?
                </el-tag>
                
                <span v-if="problem.passedTests !== undefined" class="test-stats">
                  {{ problem.passedTests }}/{{ problem.totalTests }} 通过
                </span>
              </div>
            </el-card>
          </div>
        </el-tab-pane>
        
        <el-tab-pane label="在线编程" name="editor" :disabled="!selectedProblem">
          <div v-if="selectedProblem" class="editor-section">
            <div class="editor-header">
              <h3>{{ selectedProblem.title }}</h3>
              <div class="problem-meta">
                <el-tag :type="getDifficultyTag(selectedProblem.difficulty).type">
                  {{ getDifficultyTag(selectedProblem.difficulty).text }}
                </el-tag>
                <span class="tags-list">
                  <el-tag 
                    v-for="tag in selectedProblem.tags" 
                    :key="tag"
                    size="small"
                    type="info"
                  >
                    {{ tag }}
                  </el-tag>
                </span>
              </div>
            </div>
            
            <div class="problem-desc">
              <h4>题目描述</h4>
              <div v-html="renderMarkdown(selectedProblem.description)"></div>
            </div>
            
            <div class="code-editor">
              <div class="editor-toolbar">
                <span>JavaScript 编辑器</span>
                <div class="toolbar-actions">
                  <el-button 
                    type="primary" 
                    size="small"
                    :loading="isRunning"
                    @click="runCode"
                  >
                    <el-icon><CaretRight /></el-icon>
                    运行代码
                  </el-button>
                  <el-button 
                    type="success" 
                    size="small"
                    @click="submitSolution"
                    :disabled="!testResults || testResults.passed !== testResults.total"
                  >
                    <el-icon><Upload /></el-icon>
                    提交解答
                  </el-button>
                </div>
              </div>
              
              <el-input
                v-model="userCode"
                type="textarea"
                :rows="15"
                placeholder="在这里编写你的代�?.."
                class="code-input"
                resize="none"
              />
            </div>
            
            <div v-if="testResults" class="test-results">
              <h4>测试结果</h4>
              <div class="results-summary">
                <el-tag :type="testResults.passed === testResults.total ? 'success' : 'warning'">
                  通过: {{ testResults.passed }}/{{ testResults.total }}
                </el-tag>
              </div>
              
              <div class="test-cases">
                <div 
                  v-for="(result, index) in testResults.results" 
                  :key="index"
                  class="test-case"
                  :class="{ 'passed': result.passed, 'failed': !result.passed }"
                >
                  <div class="case-header">
                    <el-icon :color="result.passed ? '#67C23A' : '#F56C6C'">
                      <Check v-if="result.passed" />
                      <Close v-else />
                    </el-icon>
                    <span>测试用例 {{ index + 1 }}</span>
                  </div>
                  
                  <div class="case-details">
                    <div class="input-output">
                      <div>
                        <strong>输入:</strong>
                        <pre>{{ result.input }}</pre>
                      </div>
                      <div>
                        <strong>期望输出:</strong>
                        <pre>{{ result.expected }}</pre>
                      </div>
                      <div v-if="result.error">
                        <strong>错误信息:</strong>
                        <pre class="error">{{ result.error }}</pre>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          
          <div v-else class="no-selection">
            <el-icon size="60" color="#999999"><Document /></el-icon>
            <p>请先从题目列表中选择一道题�?/p>
          </div>
        </el-tab-pane>
      </el-tabs>
    </div>
  </div>
</template>

