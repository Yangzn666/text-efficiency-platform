<script setup lang="ts">
import { ref, computed, onMounted } from 'vue'
import { useEnglishStore } from '@/stores/english'
import { ElMessage } from 'element-plus'

const englishStore = useEnglishStore()

const activeTab = ref('review')
const currentWord = ref<any>(null)
const masteryLevel = ref(50)
const showDefinition = ref(false)
const studyMode = ref<'flashcard' | 'quiz' | 'list'>('flashcard')
const selectedTags = ref<string[]>([])

// 计算属�?
const vocabulary = computed(() => englishStore.vocabularyWords)
const vocabularyStats = computed(() => englishStore.vocabularyStats)
const dueForReview = computed(() => englishStore.dueForReview)
const weakWords = computed(() => englishStore.weakVocabulary)

const filteredVocabulary = computed(() => {
  let filtered = vocabulary.value
  
  if (selectedTags.value.length > 0) {
    filtered = filtered.filter(word => 
      word.tags.some(tag => selectedTags.value.includes(tag))
    )
  }
  
  return filtered
})

const allTags = computed(() => {
  const tags = new Set<string>()
  vocabulary.value.forEach(word => {
    word.tags.forEach(tag => tags.add(tag))
  })
  return Array.from(tags).sort()
})

const getNextWord = () => {
  const availableWords = studyMode.value === 'review' 
    ? dueForReview.value 
    : filteredVocabulary.value.filter(w => !w.userAnswer)
    
  if (availableWords.length > 0) {
    currentWord.value = availableWords[Math.floor(Math.random() * availableWords.length)]
    masteryLevel.value = currentWord.value.masteryLevel
    showDefinition.value = false
  } else {
    currentWord.value = null
    ElMessage.info('没有更多单词�?)
  }
}

const markMastery = async (level: number) => {
  if (!currentWord.value) return

  try {
    await englishStore.updateVocabularyMastery(currentWord.value.id, level)
    
    const levelText = level >= 90 ? '完全掌握' : 
                     level >= 70 ? '熟练掌握' : 
                     level >= 50 ? '基本掌握' : '还需练习'
    
    ElMessage.success(`标记�?{levelText} (${level}%)`)
    
    // 自动获取下一个单�?
    setTimeout(getNextWord, 1000)
  } catch (error) {
    ElMessage.error('更新失败')
  }
}

const toggleDefinition = () => {
  showDefinition.value = !showDefinition.value
}

const addNewWord = async () => {
  // 简单的添加单词功能（实际应用中应该有表单）
  const newWord = {
    word: 'example',
    phonetic: '/ɪɡˈzæmpəl/',
    definition: '例子，样�?,
    example: 'This is an example sentence.',
    frequency: 10,
    tags: ['基础词汇']
  }
  
  try {
    await englishStore.addVocabularyWord(newWord)
    ElMessage.success('单词添加成功�?)
  } catch (error) {
    ElMessage.error('添加失败')
  }
}

const exportVocabulary = () => {
  const exportData = {
    words: vocabulary.value,
    stats: vocabularyStats.value,
    exportTime: new Date().toISOString()
  }
  
  const blob = new Blob([JSON.stringify(exportData, null, 2)], { type: 'application/json' })
  const url = URL.createObjectURL(blob)
  
  const a = document.createElement('a')
  a.href = url
  a.download = `词汇表_${new Date().toISOString().split('T')[0]}.json`
  a.click()
  
  URL.revokeObjectURL(url)
  ElMessage.success('导出成功�?)
}

onMounted(() => {
  englishStore.initializeEnglishData()
  getNextWord()
})
</script>

<template>
  <div class="vocabulary-container">
    <!-- 顶部统计 -->
    <div class="stats-section">
      <h2 class="section-title">英语词汇记忆系统</h2>
      <p class="section-description">科学记忆，高效掌握考研核心词汇</p>
      
      <div class="stats-cards">
        <div class="stat-card">
          <div class="stat-value">{{ vocabularyStats.total }}</div>
          <div class="stat-label">总词�?/div>
        </div>
        <div class="stat-card">
          <div class="stat-value">{{ vocabularyStats.mastered }}</div>
          <div class="stat-label">已掌�?/div>
        </div>
        <div class="stat-card">
          <div class="stat-value">{{ vocabularyStats.learning }}</div>
          <div class="stat-label">学习�?/div>
        </div>
        <div class="stat-card">
          <div class="stat-value">{{ dueForReview.length }}</div>
          <div class="stat-label">待复�?/div>
        </div>
      </div>
    </div>

    <!-- 学习模式选择 -->
    <div class="mode-section">
      <el-card>
        <template #header>
          <h3>学习模式</h3>
        </template>
        
        <div class="mode-selector">
          <el-radio-group v-model="studyMode" @change="getNextWord">
            <el-radio-button label="flashcard">闪卡模式</el-radio-button>
            <el-radio-button label="quiz">测验模式</el-radio-button>
            <el-radio-button label="list">列表模式</el-radio-button>
          </el-radio-group>
          
          <div class="tag-filter">
            <span>标签筛�?</span>
            <el-checkbox-group v-model="selectedTags">
              <el-checkbox 
                v-for="tag in allTags" 
                :key="tag"
                :label="tag"
              >
                {{ tag }}
              </el-checkbox>
            </el-checkbox-group>
          </div>
        </div>
      </el-card>
    </div>

    <!-- 主要学习区域 -->
    <div class="learning-content">
      <el-tabs v-model="activeTab" class="vocabulary-tabs">
        <el-tab-pane label="单词学习" name="review">
          <div v-if="currentWord" class="flashcard-mode">
            <div class="word-card" :class="{ 'show-definition': showDefinition }">
              <div class="word-front">
                <div class="word-main">{{ currentWord.word }}</div>
                <div class="word-phonetic">{{ currentWord.phonetic }}</div>
                <el-button 
                  type="primary" 
                  plain
                  @click="toggleDefinition"
                >
                  {{ showDefinition ? '隐藏释义' : '显示释义' }}
                </el-button>
              </div>
              
              <div v-show="showDefinition" class="word-back">
                <div class="word-definition">
                  <h3>释义</h3>
                  <p>{{ currentWord.definition }}</p>
                </div>
                
                <div class="word-example">
                  <h3>例句</h3>
                  <p>{{ currentWord.example }}</p>
                </div>
                
                <div class="word-info">
                  <div class="info-item">
                    <span class="label">出现频次:</span>
                    <span class="value">{{ currentWord.frequency }}</span>
                  </div>
                  <div class="info-item">
                    <span class="label">掌握程度:</span>
                    <span class="value">{{ currentWord.masteryLevel }}%</span>
                  </div>
                  <div class="info-item">
                    <span class="label">标签:</span>
                    <div class="tags">
                      <el-tag 
                        v-for="tag in currentWord.tags" 
                        :key="tag"
                        size="small"
                        type="info"
                      >
                        {{ tag }}
                      </el-tag>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            
            <div class="mastery-controls">
              <h4>掌握程度评估</h4>
              <div class="mastery-slider">
                <el-slider
                  v-model="masteryLevel"
                  :min="0"
                  :max="100"
                  show-input
                  :marks="{
                    0: '完全不会',
                    25: '模糊认识',
                    50: '基本掌握',
                    75: '熟练掌握',
                    100: '完全掌握'
                  }"
                />
              </div>
              
              <div class="mastery-buttons">
                <el-button @click="markMastery(0)">不会</el-button>
                <el-button @click="markMastery(25)">模糊</el-button>
                <el-button @click="markMastery(50)">一�?/el-button>
                <el-button @click="markMastery(75)">熟练</el-button>
                <el-button @click="markMastery(100)">掌握</el-button>
              </div>
              
              <div class="navigation-buttons">
                <el-button 
                  type="primary" 
                  size="large"
                  @click="getNextWord"
                >
                  <el-icon><Refresh /></el-icon>
                  下一个单�?
                </el-button>
              </div>
            </div>
          </div>
          
          <div v-else class="no-words">
            <el-icon size="80" color="#999999"><Collection /></el-icon>
            <p>暂无可学习的单词</p>
            <el-button @click="addNewWord">添加新单�?/el-button>
          </div>
        </el-tab-pane>
        
        <el-tab-pane label="词汇列表" name="list">
          <div class="vocabulary-list">
            <div class="list-controls">
              <el-button @click="exportVocabulary">
                <el-icon><Download /></el-icon>
                导出词汇�?
              </el-button>
            </div>
            
            <div class="words-grid">
              <el-card 
                v-for="word in filteredVocabulary" 
                :key="word.id"
                class="word-item"
              >
                <div class="word-header">
                  <h4>{{ word.word }}</h4>
                  <el-tag 
                    :type="word.masteryLevel >= 80 ? 'success' : 
                           word.masteryLevel >= 50 ? 'warning' : 'danger'"
                    size="small"
                  >
                    {{ word.masteryLevel }}%
                  </el-tag>
                </div>
                
                <div class="word-details">
                  <p class="phonetic">{{ word.phonetic }}</p>
                  <p class="definition">{{ word.definition }}</p>
                  <p class="example">{{ word.example }}</p>
                  
                  <div class="word-tags">
                    <el-tag 
                      v-for="tag in word.tags" 
                      :key="tag"
                      size="small"
                      type="info"
                    >
                      {{ tag }}
                    </el-tag>
                  </div>
                  
                  <div class="word-stats">
                    <span>频次: {{ word.frequency }}</span>
                    <span>上次复习: {{ new Date(word.lastReviewed).toLocaleDateString() }}</span>
                  </div>
                </div>
              </el-card>
            </div>
          </div>
        </el-tab-pane>
        
        <el-tab-pane label="复习计划" name="schedule">
          <div class="schedule-content">
            <div class="schedule-header">
              <h3>今日复习计划</h3>
              <p>根据艾宾浩斯遗忘曲线制定的科学复习计�?/p>
            </div>
            
            <div class="review-today">
              <el-card>
                <template #header>
                  <div class="card-header">
                    <h4>今日待复习词�?/h4>
                    <el-tag type="warning">{{ dueForReview.length }}�?/el-tag>
                  </div>
                </template>
                
                <div v-if="dueForReview.length > 0" class="review-list">
                  <div 
                    v-for="word in dueForReview.slice(0, 10)" 
                    :key="word.id"
                    class="review-item"
                  >
                    <span class="word-name">{{ word.word }}</span>
                    <span class="mastery-level">{{ word.masteryLevel }}%</span>
                    <el-button 
                      size="small" 
                      type="primary"
                      @click="currentWord = word; showDefinition = false; activeTab = 'review'"
                    >
                      立即复习
                    </el-button>
                  </div>
                </div>
                
                <div v-else class="no-review">
                  <el-icon size="40" color="#67C23A"><Check /></el-icon>
                  <p>今日复习任务已完成！</p>
                </div>
              </el-card>
            </div>
            
            <div class="weak-words">
              <el-card>
                <template #header>
                  <div class="card-header">
                    <h4>薄弱词汇</h4>
                    <el-tag type="danger">{{ weakWords.length }}�?/el-tag>
                  </div>
                </template>
                
                <div v-if="weakWords.length > 0" class="weak-list">
                  <div 
                    v-for="word in weakWords.slice(0, 8)" 
                    :key="word.id"
                    class="weak-item"
                  >
                    <div class="word-info">
                      <span class="word-name">{{ word.word }}</span>
                      <span class="mastery-level">{{ word.masteryLevel }}%</span>
                    </div>
                    <el-button 
                      size="small" 
                      type="warning"
                      @click="currentWord = word; showDefinition = false; activeTab = 'review'"
                    >
                      重点复习
                    </el-button>
                  </div>
                </div>
                
                <div v-else class="no-weak">
                  <el-icon size="40" color="#67C23A"><Star /></el-icon>
                  <p>暂无薄弱词汇�?/p>
                </div>
              </el-card>
            </div>
          </div>
        </el-tab-pane>
      </el-tabs>
    </div>
  </div>
</template>

